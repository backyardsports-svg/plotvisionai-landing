{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/_expo/:path*",
      "destination": "https://plotvisionai-app-current.vercel.app/_expo/:path*"
    },
    {
      "source": "/onboarding/:path*",
      "destination": "https://plotvisionai-app-current.vercel.app/onboarding/:path*"
    },
    {
      "source": "/new-project/:path*",
      "destination": "https://plotvisionai-app-current.vercel.app/new-project/:path*"
    },
    {
      "source": "/client/:path*",
      "destination": "https://plotvisionai-app-current.vercel.app/client/:path*"
    },
    {
      "source": "/(auth-callback|account|app|client-project|client-share|corporate-pricing|credits|new|pricing|projects)",
      "destination": "https://plotvisionai-app-current.vercel.app/$1"
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "/onboarding/sign-in",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "destination": "/onboarding/:path*",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/courts.html",
      "destination": "/backyard-sports-center.html",
      "permanent": true
    },
    {
      "source": "/epoxy-flooring.html",
      "destination": "/surfaces.html",
      "permanent": true
    },
    {
      "source": "/driveways.html",
      "destination": "/surfaces.html",
      "permanent": true
    },
    {
      "source": "/driveways-concrete.html",
      "destination": "/surfaces.html",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "landscapedesignsonline.com"
        }
      ],
      "destination": "https://www.landscapedesignsonline.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "landscapedesignsonline.com"
        }
      ],
      "destination": "https://www.landscapedesignsonline.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "plotvisionai.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "plotvisionai-vercel.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(styles.css|script.js|config.js|sw.js|site.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/login.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
